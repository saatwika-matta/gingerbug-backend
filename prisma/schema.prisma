generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  tagline     String
  description String
  price       Decimal
  currency    String   @default("USD")
  size        String
  badge       String?
  heatLevel   Int
  available   Boolean  @default(true)
  imageUrl    String?
  batch       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteConfig {
  id           String @id @default(cuid())
  heroTitle    String
  heroSubtitle String
  storyTitle   String
  storyText    String
}
model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  customerEmail   String
  items           Json
  totalAmount     Decimal
  status          String   @default("pending")
  shippingAddress Json?
  createdAt       DateTime @default(now())
}